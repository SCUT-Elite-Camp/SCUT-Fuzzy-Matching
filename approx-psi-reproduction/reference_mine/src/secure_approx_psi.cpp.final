#include "secure_approx_psi.h"

#include <algorithm>
#include <iostream>
#include <map>
#include <memory>
#include <random>
#include <string>
#include <unordered_map>
#include <vector>

#include "projection.h"

struct HamAndVMultResult {
    SecureApproxPSI::B c;
    SecureApproxPSI::U8 sum8;
};

// ============================================================
// 手动拼 wire + EMP 内置 hamming_weight
// 关键：w 是 public，直接接 wire，0 AND
// ============================================================
SecureApproxPSI::U8 SecureApproxPSI::securePopCountTree8(
    const std::vector<SecureApproxPSI::B>& v)
{
    using Ctx = SH2PCSession::ctx_t;
    using U8  = UInt_T<Ctx, 8>;

    if (v.empty()) {
        return U8::constant(sess_.ctx(), 0);
    }

    // 拼成 UInt_T<Ctx, 128>（固定 128 bit）
    // 如果 v.size() < 128，高位补 0
    constexpr int kBits = 128;
    using U128 = UInt_T<Ctx, kBits>;
    U128 x(sess_.ctx());

    std::size_t n = v.size() < kBits ? v.size() : kBits;
    for (std::size_t i = 0; i < n; ++i) {
        x.w[i] = v[i].w;   // 直接接 wire，0 AND
    }
    for (std::size_t i = n; i < kBits; ++i) {
        x.w[i] = sess_.ctx().public_bit(false);   // 补 0
    }

    // EMP 内置 hamming_weight，返回 UInt_T<Ctx, bits_for(128)> = UInt_T<Ctx, 8>
    return x.hamming_weight();
}

// ============================================================
// secureHamAndVMult：手动拼 wire + hamming_weight
// ============================================================
static HamAndVMultResult secureHamAndVMult(
    SH2PCSession& sess,
    const std::vector<SecureApproxPSI::B>& a,
    const std::vector<SecureApproxPSI::B>& b,
    std::size_t threshold)
{
    using Ctx = SH2PCSession::ctx_t;
    using U8  = UInt_T<Ctx, 8>;

    std::size_t length = a.size();

    std::vector<SecureApproxPSI::B> diff;
    diff.reserve(length);
    for (std::size_t i = 0; i < length; ++i) {
        diff.push_back(a[i] ^ b[i]);   // XOR 免费
    }

    // 拼成 UInt_T<Ctx, 128>
    constexpr int kBits = 128;
    using U128 = UInt_T<Ctx, kBits>;
    U128 x(sess.ctx());

    std::size_t n = length < kBits ? length : kBits;
    for (std::size_t i = 0; i < n; ++i) {
        x.w[i] = diff[i].w;   // 直接接 wire，0 AND
    }
    for (std::size_t i = n; i < kBits; ++i) {
        x.w[i] = sess.ctx().public_bit(false);
    }

    auto sum8 = x.hamming_weight();   // U8

    auto limit = U8::constant(sess.ctx(), static_cast<uint64_t>(threshold));
    auto c = sum8 <= limit;

    return {c, sum8};
}

SecureApproxPSI::U8 SecureApproxPSI::securePopCount(
    const std::vector<SecureApproxPSI::B>& v)
{
    return securePopCountTree8(v);
}

SecureApproxPSI::SecureApproxPSI(SH2PCSession& sess, Parameters params)
    : sess_(sess), params_(std::move(params))
{
}

std::vector<PairMatch> SecureApproxPSI::run(
    const std::vector<Element>& A,
    const std::vector<Element>& Bset)
{
    std::vector<PairMatch> matches;
    std::size_t totalCandidates = 0;
    std::mt19937_64 rng(12345);

    std::unordered_map<std::size_t, std::vector<B>> A_secure, B_secure;

    {
        auto bools = std::make_unique<bool[]>(A.size() * params_.length);
        for (std::size_t i = 0; i < A.size(); ++i)
            for (std::size_t k = 0; k < params_.length; ++k)
                bools[i * params_.length + k] = (A[i].bits[k] != 0);
        auto blocks = sess_.input_bits(ALICE, bools.get(), A.size() * params_.length);
        for (std::size_t i = 0; i < A.size(); ++i) {
            auto& v = A_secure[A[i].id];
            v.reserve(params_.length);
            for (std::size_t k = 0; k < params_.length; ++k)
                v.push_back(B::from_wires(sess_.ctx(),
                    &blocks[i * params_.length + k]));
        }
    }
    {
        auto bools = std::make_unique<bool[]>(Bset.size() * params_.length);
        for (std::size_t i = 0; i < Bset.size(); ++i)
            for (std::size_t k = 0; k < params_.length; ++k)
                bools[i * params_.length + k] = (Bset[i].bits[k] != 0);
        auto blocks = sess_.input_bits(BOB, bools.get(), Bset.size() * params_.length);
        for (std::size_t i = 0; i < Bset.size(); ++i) {
            auto& v = B_secure[Bset[i].id];
            v.reserve(params_.length);
            for (std::size_t k = 0; k < params_.length; ++k)
                v.push_back(B::from_wires(sess_.ctx(),
                    &blocks[i * params_.length + k]));
        }
    }

    for (std::size_t round = 0; round < params_.k; ++round) {
        auto projection = sampleProjection(params_.length, params_.p, rng);
        auto Aproj = projectSetWithRandomRepresentative(A, projection, rng);
        auto Bproj = projectSetWithRandomRepresentative(Bset, projection, rng);

        std::map<std::string, std::vector<std::size_t>> aBuckets, bBuckets;
        for (const auto& [key, rep] : Aproj) {
            aBuckets[key].push_back(rep.original.id);
        }
        for (const auto& [key, rep] : Bproj) {
            bBuckets[key].push_back(rep.original.id);
        }

        for (const auto& [key, aIds] : aBuckets) {
            auto it = bBuckets.find(key);
            if (it == bBuckets.end()) continue;
            const auto& bIds = it->second;

            totalCandidates += aIds.size() * bIds.size();

            for (auto i : aIds) {
                for (auto j : bIds) {
                    auto& a_secure = A_secure.at(i);
                    auto& b_secure = B_secure.at(j);

                    auto [c, sum8] = secureHamAndVMult(
                        sess_, a_secure, b_secure, params_.d);

                    // c 就是 (sum8 <= d)，直接 reveal
                    auto out = sess_.reveal(c, PUBLIC);

                    if (out.has_value() && out.value()) {
                        matches.push_back(PairMatch{i, j, params_.d, round});
                    }
                }
            }
        }
    }

    std::sort(matches.begin(), matches.end(),
        [](const PairMatch& x, const PairMatch& y) {
            if (x.a_id != y.a_id) return x.a_id < y.a_id;
            return x.b_id < y.b_id;
        });
    matches.erase(
        std::unique(matches.begin(), matches.end(),
            [](const PairMatch& x, const PairMatch& y) {
                return x.a_id == y.a_id && x.b_id == y.b_id;
            }),
        matches.end());

    std::cout << "total candidates: " << totalCandidates << "\n";
    std::cout << "num_and: " << sess_.num_and() << "\n";
    return matches;
}
