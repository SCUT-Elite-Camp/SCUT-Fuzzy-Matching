+def threshold_cluster_indices(sim_scores: np.ndarray, threshold: float) -> np.ndarray:
+    """Select every centroid with score >= threshold; fall back to Top-1.
+
+    The threshold is in the ORIGINAL centroid-score space, not the
+    final CKKS record-level cosine threshold ``tau``.
+    """
+    scores = np.asarray(sim_scores, dtype=np.float64).reshape(-1)
+    if scores.size == 0 or not np.all(np.isfinite(scores)):
+        raise ValueError("centroid scores must be nonempty and finite")
+    if not np.isfinite(threshold):
+        raise ValueError("cluster threshold must be finite")
+    indices = np.flatnonzero(scores >= threshold)
+    if indices.size == 0:
+        indices = np.array([int(np.argmax(scores))], dtype=np.int64)
+    return indices[np.argsort(-scores[indices], kind="stable")].astype(np.int64)
+
+
+def build_one_hot_for_cluster(cluster_index: int, k: int) -> np.ndarray:
+    """One cluster per request: original column-wise HE contract remains valid."""
+    if not (0 <= cluster_index < k):
+        raise ValueError("cluster index out of bounds")
+    selector = np.zeros(k, dtype=np.float64)
+    selector[cluster_index] = 1.0
+    return selector
+
+
 def encrypt_selector(
     selector: np.ndarray,
     secret_context: ts.Context,
