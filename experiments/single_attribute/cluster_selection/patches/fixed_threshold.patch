+++ b/baseline_Integration/scripts/evaluate_cluster_threshold.py
@@ -0,0 +1,180 @@
+"""Fixed centroid-score threshold sweep; no projection.
+
+Two modes:
+  plain: real MinHash/KMeans and true target-cluster coverage, no TenSEAL required.
+  ckks: real HE benchmark, one-hot per selected cluster, no projection.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from minhash.encoder import batch_encode
+from party_b.offline_prep import prepare_party_b_offline
+from preprocessing.normalizer import l2_normalize
+from config.params import NUM_PERMUTATIONS_CLUSTER
+
+# These are project-specific *centroid dot-product scores*, not record-level tau.
+DEFAULT_THRESHOLDS = [-5, -2, 0, 2, 5]
+
+
+def threshold_select(scores: np.ndarray, threshold: float) -> np.ndarray:
+    if not np.isfinite(threshold):
+        raise ValueError("threshold must be finite")
+    scores = np.asarray(scores, dtype=float)
+    if scores.ndim != 1 or not scores.size or not np.all(np.isfinite(scores)):
+        raise ValueError("scores must be a nonempty finite 1-D array")
+    chosen = np.flatnonzero(scores >= threshold)
+    if not chosen.size:
+        chosen = np.array([int(np.argmax(scores))])
+    return chosen[np.argsort(-scores[chosen], kind="stable")]
+
+
+def read_ncvr(data_path: Path, db_limit: int, query_limit: int):
+    dbfile = data_path / "ncvr_10k_database.csv"
+    qfile = data_path / "ncvr_10k_queries.csv"
+    with dbfile.open(encoding="utf-8-sig", newline="") as f:
+        db_rows = list(csv.DictReader(f))
+    with qfile.open(encoding="utf-8-sig", newline="") as f:
+        q_rows = list(csv.DictReader(f))
+    if db_limit > 0: db_rows = db_rows[:db_limit]
+    if query_limit > 0: q_rows = q_rows[:query_limit]
+    return db_rows, q_rows
+
+
+def fuzz_query(name: str, rng: np.random.Generator) -> str:
+    positions = [i for i, ch in enumerate(name) if ch.isascii() and ch.isalpha()]
+    if not positions: return name
+    pos = int(rng.choice(positions))
+    old = name[pos].upper()
+    replacement = chr(ord('A') + (ord(old)-ord('A')+int(rng.integers(1,26)))%26)
+    return name[:pos]+replacement+name[pos+1:]
+
+
+def plain_sweep(args):
+    db_rows, q_rows = read_ncvr(Path(args.data_path), args.db_limit, args.query_limit)
+    names_b = [r['full_name'] for r in db_rows]
+    print(f'Offline K-Means: database={len(names_b)}, clusters={args.clusters}')
+    artifacts = prepare_party_b_offline(names_b, k_mode=args.clusters)
+    rng = np.random.default_rng(args.fuzzy_seed)
+    names_q = []
+    for row in q_rows:
+        name = row['query_name']
+        if str(row['label']).lower() in ('true','1') and rng.random()<args.fuzzy_ratio:
+            name = fuzz_query(name, rng)
+        names_q.append(name)
+    raw = batch_encode(names_q, NUM_PERMUTATIONS_CLUSTER)
+    q_norm = l2_normalize(raw)
+    q_std = (q_norm - artifacts.scaler_mean) / artifacts.scaler_scale
+    # This matches compare_to_centroids, which evaluates DOT PRODUCT, not cosine(query_std, centroid).
+    scores = q_std @ artifacts.centroids.T
+    sizes = np.bincount(artifacts.cluster_assignments, minlength=len(artifacts.centroids))
+    known_ids = {r['ncid']: i for i,r in enumerate(db_rows)}
+    outdir = Path(args.output_dir); outdir.mkdir(parents=True,exist_ok=True)
+    details, summary = [], []
+    for eta in args.thresholds:
+        selected = [threshold_select(row, eta) for row in scores]
+        counts = [int(sizes[idx].sum()) for idx in selected]
+        ks = [len(idx) for idx in selected]
+        target_valid, target_hit = 0,0
+        for i,row in enumerate(q_rows):
+            ispos = str(row['label']).lower() in ('true','1')
+            target_idx = known_ids.get(row['query_ncid']) if ispos else None
+            covered = None
+            if target_idx is not None:
+                target_valid+=1
+                covered=bool(artifacts.cluster_assignments[target_idx] in selected[i])
+                target_hit+=int(covered)
+            details.append({
+                'threshold':eta,'query_index':i,'query_ncid':row['query_ncid'],
+                'label':row['label'],'query_name':names_q[i],
+                'score_max':float(np.max(scores[i])),
+                'score_min':float(np.min(scores[i])),
+                'selected_k':ks[i], 'selected_clusters':';'.join(map(str,selected[i])),
+                'candidate_records':counts[i], 'known_target_in_candidates':covered,
+            })
+        record={
+            'threshold':float(eta),'num_queries':len(q_rows),'num_clusters':len(artifacts.centroids),
+            'mean_k':float(np.mean(ks)),'median_k':float(np.median(ks)),
+            'max_k':int(max(ks)),'mean_candidates':float(np.mean(counts)),
+            'p95_candidates':float(np.percentile(counts,95)),
+            'target_positives':target_valid,'target_hits':target_hit,
+            'target_coverage':target_hit/target_valid if target_valid else None,
+            'fallback_top1_queries':int(np.sum(np.max(scores,axis=1)<eta)),
+            'min_centroid_score':float(np.min(scores)),
+            'median_max_centroid_score':float(np.median(np.max(scores,axis=1))),
+            'max_centroid_score':float(np.max(scores)),
+        }
+        summary.append(record)
+        print(f"eta={eta:>8g} | avg K={record['mean_k']:.2f} | avg records={record['mean_candidates']:.1f} | target cover={record['target_coverage']}")
+    def write_csv(path,rows):
+        with path.open('w',encoding='utf-8-sig',newline='') as f:
+            wr=csv.DictWriter(f,fieldnames=list(rows[0])); wr.writeheader(); wr.writerows(rows)
+    write_csv(outdir/'summary.csv',summary)
+    write_csv(outdir/'per_query.csv',details)
+    (outdir/'summary.json').write_text(json.dumps({'mode':'plain','thresholds':args.thresholds,
+        'fuzzy_ratio':args.fuzzy_ratio,'fuzzy_note':'plain mode uses a reproducible custom single-letter substitution; official pipeline may differ',
+        'summary':summary},ensure_ascii=False,indent=2),encoding='utf-8')
+    print('Outputs:',outdir)
+
+
+def ckks_sweep(args):
+    try:
+        from evaluation.benchmark import benchmark
+        from evaluation.reporting import save_evaluation_report
+    except ModuleNotFoundError as exc:
+        raise SystemExit(f'CKKS mode needs full requirements installed: {exc}') from exc
+    outdir=Path(args.output_dir);outdir.mkdir(parents=True,exist_ok=True)
+    results=[]
+    for eta in args.thresholds:
+        config={'dataset':'ncvr_10k','data_path':str(Path(args.data_path).parent),
+            'el_cluster':200,'el_match':50,'k':args.clusters,'k_mode':args.clusters,
+            'tau':args.tau,'fuzzy_ratio':args.fuzzy_ratio,'fuzzy_seed':args.fuzzy_seed,
+            'query_limit':args.query_limit,'db_limit':args.db_limit,
+            'he_batch_size':0,'use_mock':False,'early_stop':not args.no_early_stop,
+            'reuse_context':True,'cluster_threshold':float(eta)}
+        print('CKKS running threshold=',eta,flush=True)
+        result=benchmark(config)
+        suffix=str(eta).replace('-','neg').replace('.','p')
+        save_evaluation_report(result,outdir/f'eta_{suffix}',prefix='ncvr_10k')
+        results.append({'threshold':eta,'metrics':result['metrics'],
+                        'confusion':result.get('confusion',{}),
+                        'timing_sec':result['timing_sec'],
+                        'communication_mb':result['communication_mb'],
+                        'mean_k':result.get('cluster_selection',{}).get('mean_k'),
+                        'mean_candidates':result.get('cluster_selection',{}).get('mean_candidate_count')})
+    (outdir/'ckks_comparison.json').write_text(json.dumps(results,ensure_ascii=False,indent=2),encoding='utf-8')
+    print('Outputs:',outdir)
+
+
+def main():
+    parser=argparse.ArgumentParser(description='Fixed threshold cluster selection (without projection).')
+    parser.add_argument('--mode', choices=['plain','ckks'],default='plain')
+    parser.add_argument('--data-path',default=str(ROOT/'data'/'ncvr_10k'))
+    parser.add_argument('--output-dir',default=str(ROOT/'artifacts'/'fixed_threshold'))
+    parser.add_argument('--thresholds',type=float,nargs='+',default=DEFAULT_THRESHOLDS)
+    parser.add_argument('--clusters',type=int,default=50)
+    parser.add_argument('--query-limit',type=int,default=200)
+    parser.add_argument('--db-limit',type=int,default=-1)
+    parser.add_argument('--fuzzy-ratio',type=float,default=0.3)
+    parser.add_argument('--fuzzy-seed',type=int,default=42)
+    parser.add_argument('--tau',type=float,default=0.9)
+    parser.add_argument('--no-early-stop',action='store_true')
+    args=parser.parse_args()
+    if not args.thresholds or not all(np.isfinite(t) for t in args.thresholds):
+        parser.error('thresholds must be finite values')
+    if not 0<=args.fuzzy_ratio<=1:parser.error('fuzzy-ratio must lie in [0,1]')
+    if args.clusters<=0:parser.error('clusters must be positive')
+    if args.mode=='plain':plain_sweep(args)
+    else:ckks_sweep(args)
+
+if __name__=='__main__':main()
