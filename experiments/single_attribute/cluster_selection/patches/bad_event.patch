+"""Bad-event-calibrated, query-adaptive cluster selection (no projection).
+
+The finite-sample guarantee is *marginal* for exchangeable calibration/test
+positive query examples. No query-specific conditional guarantee is claimed.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import math
+import numpy as np
+
+
+@dataclass(frozen=True)
+class BadEventCalibration:
+    epsilon: float
+    delta: float
+    n_calibration: int
+    order_statistic: int
+    used_all_clusters_fallback: bool
+
+
+def calibrate_delta(scores: np.ndarray, matching_cluster: np.ndarray, epsilon: float) -> BadEventCalibration:
+    """Conformal quantile of D=max(center score)-score(true target cluster).
+
+    Each row must correspond to an independent/exchangeable positive *query*
+    with exactly one designated match, or to a query-level score constructed
+    from all matches consistently with the evaluation target.
+    """
+    scores = np.asarray(scores, dtype=np.float64)
+    labels = np.asarray(matching_cluster, dtype=int).reshape(-1)
+    if scores.ndim != 2 or scores.shape[0] != len(labels) or scores.size == 0:
+        raise ValueError('scores must have shape (n_calibration, n_clusters), with n_calibration > 0')
+    if not 0 < epsilon < 1:
+        raise ValueError('epsilon must lie strictly between 0 and 1')
+    if np.any(~np.isfinite(scores)) or np.any(labels < 0) or np.any(labels >= scores.shape[1]):
+        raise ValueError('nonfinite scores or invalid matching cluster')
+    deficits = scores.max(axis=1) - scores[np.arange(len(labels)), labels]
+    ordered = np.sort(np.maximum(deficits, 0.0))
+    j = math.ceil((len(ordered) + 1) * (1 - epsilon))
+    delta = float(ordered[j - 1]) if j <= len(ordered) else float('inf')
+    return BadEventCalibration(float(epsilon), delta, len(ordered), j, bool(j > len(ordered)))
+
+
+def select_clusters(scores: np.ndarray, delta: float) -> np.ndarray:
+    """Select all clusters with score >= top_score - delta (include ties)."""
+    scores = np.asarray(scores, dtype=np.float64).reshape(-1)
+    if not len(scores) or np.any(~np.isfinite(scores)):
+        raise ValueError('scores must be a non-empty finite vector')
+    if delta < 0 or np.isnan(delta):
+        raise ValueError('delta must be nonnegative')
+    # Include boundary ties. Tiny tolerance absorbs numerical differences between
+    # the same score computed in different floating point paths.
+    return np.flatnonzero(scores >= scores.max() - delta - 1e-12).astype(int)
+
+
+def select_topk(scores: np.ndarray, k: int) -> np.ndarray:
+    scores = np.asarray(scores, dtype=float).reshape(-1)
+    if not 1 <= k <= len(scores):
+        raise ValueError('invalid fixed top-k')
+    return np.argsort(-scores, kind='stable')[:k].astype(int)
diff --git a/baseline_Integration/scripts/evaluate_bad_event_topk.py b/baseline_Integration/scripts/evaluate_bad_event_topk.py
