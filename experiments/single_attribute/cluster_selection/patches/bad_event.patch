--- /dev/null
+++ b/baseline_Integration/scripts/evaluate_bad_event_topk.py
@@ -0,0 +1,162 @@
+"""NCVR 10K: compare Bad-Event dynamic Top-K to Top-1/2/3 WITHOUT projection.
+
+Run from repository root:
+    python scripts/evaluate_bad_event_topk.py --epsilons 0.20 0.10 0.05 0.02
+This intentionally evaluates the plaintext algorithmic candidate stage.
+It does NOT claim CKKS/PSI communication or end-to-end security measurements.
+"""
+from __future__ import annotations
+import argparse
+import csv
+import json
+from pathlib import Path
+import sys
+import time
+import numpy as np
+from sklearn.preprocessing import StandardScaler
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+from clustering.bad_event_topk import calibrate_delta, select_clusters, select_topk
+from clustering.kmeans_cosine import run_cosine_kmeans
+from minhash.encoder import batch_encode
+from preprocessing.normalizer import l2_normalize
+
+
+def get_args():
+    p=argparse.ArgumentParser(description='Evaluate calibrated Bad Event dynamic Top-K (no projection, no HE).')
+    p.add_argument('--data-dir',type=Path,default=ROOT/'data/ncvr_10k')
+    p.add_argument('--output-dir',type=Path,default=ROOT/'artifacts/bad_event_topk')
+    p.add_argument('--clusters',type=int,default=50,help='Total K-Means clusters M, not number selected per query')
+    p.add_argument('--calibration-positives',type=int,default=50)
+    p.add_argument('--fuzzy-ratio',type=float,default=.3)
+    p.add_argument('--fuzzy-seed',type=int,default=42)
+    p.add_argument('--split-seed',type=int,default=2026)
+    p.add_argument('--kmeans-seed',type=int,default=42)
+    p.add_argument('--epsilons',type=float,nargs='+',default=[.20,.10,.05,.02])
+    p.add_argument('--tau',type=float,default=.9,help='Original final-match cosine threshold')
+    p.add_argument('--no-cosine-eval',action='store_true',help='Only evaluate ID-grounded target-cluster coverage')
+    return p.parse_args()
+
+
+def prepare_english_ncvr(names_q, names_b, labels, *, fuzzy_ratio, fuzzy_seed):
+    """Match english_v1 + single_substitution with no other pipeline dependencies.
+
+    The original data_pipeline requires the optional `anyascii` dependency even
+    for English; this function retains its English branch and perturbation RNG.
+    """
+    import random
+    import string
+    from preprocessing.text_cleaner import clean_name
+    if not 0 <= fuzzy_ratio <= 1: raise ValueError('fuzzy-ratio must be between 0 and 1')
+    qb=[clean_name(v) for v in names_q]
+    db=[clean_name(v) for v in names_b]
+    eligible=[i for i in range(len(qb)) if labels[i] and any(c in string.ascii_lowercase for c in qb[i])]
+    target_count=int(len(eligible)*fuzzy_ratio+.5)
+    rng=random.Random(fuzzy_seed)
+    selected=rng.sample(eligible,target_count)
+    forbidden=set(db)
+    for idx in selected:
+        original=qb[idx]
+        positions=[i for i,c in enumerate(original) if c in string.ascii_lowercase]
+        rng.shuffle(positions)
+        for position in positions:
+            replacements=[c for c in string.ascii_lowercase if c!=original[position]]
+            rng.shuffle(replacements)
+            candidates=(original[:position]+c+original[position+1:] for c in replacements)
+            alternative=next((s for s in candidates if s not in forbidden),None)
+            if alternative is not None:
+                qb[idx]=alternative
+                break
+    return qb,db
+
+def main():
+    a=get_args(); start=time.perf_counter(); a.output_dir.mkdir(parents=True,exist_ok=True)
+    with (a.data_dir/'ncvr_10k_database.csv').open(encoding='utf8',newline='') as f: db=list(csv.DictReader(f))
+    with (a.data_dir/'ncvr_10k_queries.csv').open(encoding='utf8',newline='') as f: qs=list(csv.DictReader(f))
+    labs=np.asarray([q['label'].strip().lower() in ('true','1','yes') for q in qs],dtype=bool)
+    queries,names_b=prepare_english_ncvr([q['query_name'] for q in qs], [r['full_name'] for r in db], labs,fuzzy_ratio=a.fuzzy_ratio,fuzzy_seed=a.fuzzy_seed)
+    id_to_row={r['ncid']:i for i,r in enumerate(db)}
+    target=np.asarray([id_to_row.get(q['query_ncid'],-1) for q in qs],dtype=int)
+    positive=np.flatnonzero(labs)
+    if np.any(target[positive]<0):
+        raise RuntimeError('Positive query has no database target by NCID: cannot calibrate without ground truth')
+    if not 1<=a.calibration_positives<len(positive): raise ValueError('calibration-positives must be 1..positive_count-1')
+    rng=np.random.RandomState(a.split_seed); shuffled=rng.permutation(positive)
+    cal=shuffled[:a.calibration_positives]
+    test=np.sort(np.concatenate((shuffled[a.calibration_positives:],np.flatnonzero(~labs))))
+    print(f'Database={len(db)}, cluster count={a.clusters}, calibration positives={len(cal)}, test positives={np.sum(labs[test])}, test negatives={np.sum(~labs[test])}',flush=True)
+    print('Encoding database MinHash EL=200...',flush=True)
+    db_raw=batch_encode(names_b,200); db_200=l2_normalize(db_raw)
+    scaler=StandardScaler().fit(db_200)
+    print('Training spherical K-Means...',flush=True)
+    centroids,assignment=run_cosine_kmeans(scaler.transform(db_200),a.clusters,random_state=a.kmeans_seed)
+    del db_raw,db_200
+    print('Encoding queries and scoring centroids...',flush=True)
+    q_raw=batch_encode(queries,200)
+    q_sc=scaler.transform(l2_normalize(q_raw))
+    q_sc_norm=l2_normalize(q_sc)
+    scores=q_sc_norm@centroids.T
+    matched_cl=assignment[target[cal]]
+    configs={f'Top-{k}':{'epsilon':None,'delta':None,'calibration':None} for k in [1,2,3]}
+    for epsilon in a.epsilons:
+        calibration=calibrate_delta(scores[cal],matched_cl,epsilon)
+        configs[f'Dynamic-eps-{epsilon:g}']={'epsilon':epsilon,'delta':calibration.delta,'calibration':calibration.__dict__}
+    # Reuse baseline EL=50 cosine representation for the OPTIONAL plaintext
+    # final decision. Distinguish model prediction from ID target coverage.
+    db_match=l2_normalize(batch_encode(names_b,50)) if not a.no_cosine_eval else None
+    query_match=l2_normalize(q_raw[:,:50]) if not a.no_cosine_eval else None
+    # Avoid pairwise 10K x 10K materialization; index candidate record rows per selected cluster.
+    cluster_rows=[np.flatnonzero(assignment==i) for i in range(a.clusters)]
+    details=[]; summary=[]
+    for name,conf in configs.items():
+        k_sizes=[]; candidate_sizes=[]; target_hits=[]; tp=fp=tn=fn=0
+        for idx in test:
+            chosen=select_topk(scores[idx],int(name.split('-')[1])) if name.startswith('Top-') else select_clusters(scores[idx],conf['delta'])
+            rows=np.concatenate([cluster_rows[int(j)] for j in chosen])
+            covered=(target[idx]>=0 and int(assignment[target[idx]]) in chosen)
+            k_sizes.append(len(chosen));candidate_sizes.append(len(rows))
+            if labs[idx]: target_hits.append(bool(covered))
+            pred=None
+            if db_match is not None:
+                similarity=db_match[rows]@query_match[idx]
+                pred=bool(np.any(similarity>=a.tau))
+                if pred and labs[idx]:tp+=1
+                elif pred:fp+=1
+                elif labs[idx]:fn+=1
+                else:tn+=1
+            details.append({'strategy':name,'query_index':int(idx),'query_ncid':qs[idx]['query_ncid'],
+                'label':bool(labs[idx]),'target_cluster':int(assignment[target[idx]]) if labs[idx] else None,
+                'top1_cluster':int(np.argmax(scores[idx])),'selected_clusters':chosen.tolist(),
+                'selected_k':int(len(chosen)),'candidate_count':int(len(rows)),
+                'target_cluster_covered':bool(covered) if labs[idx] else None,
+                'threshold_prediction':pred,'epsilon':conf['epsilon'],'delta':conf['delta']})
+        result={'strategy':name,'epsilon':conf['epsilon'],'delta':conf['delta'],
+            'n_calibration_positive':len(cal),'n_test_positive':len(target_hits),'n_test_negative':int(np.sum(~labs[test])),
+            'target_cluster_recall':float(np.mean(target_hits)), 'bad_rate':float(1-np.mean(target_hits)),
+            'avg_selected_k':float(np.mean(k_sizes)),'median_selected_k':float(np.median(k_sizes)),
+            'p95_selected_k':float(np.percentile(k_sizes,95)),
+            'min_selected_k':int(np.min(k_sizes)),'max_selected_k':int(np.max(k_sizes)),
+            'avg_candidate_count':float(np.mean(candidate_sizes)),
+            'p95_candidate_count':float(np.percentile(candidate_sizes,95)),
+            'candidate_reduction_vs_full_db':float(1-np.mean(candidate_sizes)/len(db)),
+            'calibration_all_cluster_fallback':bool(conf['calibration']['used_all_clusters_fallback']) if conf['calibration'] else False}
+        if db_match is not None:
+            result.update({'TP':tp,'FP':fp,'FN':fn,'TN':tn,
+                'precision':float(tp/max(1,tp+fp)),'recall':float(tp/max(1,tp+fn)),
+                'f1':float(2*tp/max(1,2*tp+fp+fn)), 'accuracy':float((tp+tn)/len(test))})
+        summary.append(result)
+        print(f'{name:>19}: bad={result["bad_rate"]:.3f} avgK={result["avg_selected_k"]:.2f} candidates={result["avg_candidate_count"]:.1f}',flush=True)
+    with (a.output_dir/'comparison.csv').open('w',newline='',encoding='utf8') as f:
+        w=csv.DictWriter(f,fieldnames=list(summary[0].keys()),extrasaction='ignore');w.writeheader();w.writerows(summary)
+    with (a.output_dir/'per_query.csv').open('w',newline='',encoding='utf8') as f:
+        w=csv.DictWriter(f,fieldnames=list(details[0].keys()));w.writeheader();w.writerows(details)
+    report={'note':'Plaintext candidate-coverage study; no random projection; no CKKS/PSI timing or secure protocol claims',
+        'settings':vars(a)|{'data_dir':str(a.data_dir),'output_dir':str(a.output_dir)},
+        'calibration_query_indices':cal.tolist(),'test_query_indices':test.tolist(),
+        'calibrations':{name:v['calibration'] for name,v in configs.items() if v['calibration']},
+        'summary':summary,'elapsed_sec':time.perf_counter()-start}
+    with (a.output_dir/'report.json').open('w',encoding='utf8') as f:json.dump(report,f,ensure_ascii=False,indent=2)
+    print('Results written to',a.output_dir,'elapsed',round(report['elapsed_sec'],2),'seconds',flush=True)
+
+if __name__=='__main__':main()
diff --git a/baseline_Integration/tests/test_bad_event_topk.py b/baseline_Integration/tests/test_bad_event_topk.py
